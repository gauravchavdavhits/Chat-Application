# Server & Network Configuration
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/chat-app?retryWrites=true&w=majority
CORS_ORIGIN=https://YOUR_GITHUB_USERNAME.github.io

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d
LOG_LEVEL=info

# Redis In-Memory Cache (Set true if using Upstash / Redis Cloud, or false to use fast in-memory mode)
REDIS_ENABLED=false
REDIS_URI=rediss://default:<password>@<host>:<port>

# Email SMTP Configuration (Nodemailer - Optional for OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Bidirectional Chat" <no-reply@bidirectionalchat.com>
